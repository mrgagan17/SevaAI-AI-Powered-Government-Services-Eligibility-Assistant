# SevaAI Configuration

# JWT Authentication
SECRET_KEY=change-this-to-a-very-long-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM Provider: "ollama" for local runs, or "gemini" for Google Cloud hosting
LLM_PROVIDER=ollama

# Google Gemini Configuration (Recommended when hosting on Google Cloud)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Configuration (Default for local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Embedding & Vector Database
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma
DATABASE_URL=sqlite:///./sevaai.db

# RAG Configuration
TOP_K=5
MAX_UPLOAD_SIZE_MB=20

# Static File Serving (Set to true in production containers)
SERVE_STATIC=true
PORT=8080
